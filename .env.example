# PIN required to log in to the app
APP_PIN=1640

# Random long random string used to sign session cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Anthropic API key, used for the chat/voice assistant.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Postgres connection string. When you attach Vercel Postgres (Storage tab
# in your Vercel project) this is set for you automatically in Production/
# Preview. For local development, run `vercel env pull .env.local` after
# attaching the database, or point this at any Postgres instance.
POSTGRES_URL=
